{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Obscura",
  "version": "1.0.0",
  "identifier": "network.obscura.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev --prefix ..",
    "beforeBuildCommand": "npm run build --prefix .."
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Obscura",
        "width": 420,
        "height": 780,
        "minWidth": 380,
        "minHeight": 600,
        "maxWidth": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "theme": "Dark",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:8080 ws://localhost:8080 https://fonts.googleapis.com https://fonts.gstatic.com data: blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "© 2025 Obscura Network",
    "category": "Network",
    "shortDescription": "Zero-Knowledge Secure Messaging",
    "longDescription": "Obscura — Signal protokolü tabanlı, sıfır bilgi kanıtı destekli şifreli mesajlaşma uygulaması."
  }
}
