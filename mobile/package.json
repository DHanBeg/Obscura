{
  "name": "@obscura/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "gen-assets": "node scripts/gen-assets.mjs && node scripts/sync-launcher-icons.mjs",
    "test": "jest --watchAll=false"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@react-navigation/native": "^6.1.17",
    "@scure/bip39": "^1.4.0",
    "expo": "~51.0.0",
    "expo-av": "~14.0.0",
    "expo-blur": "~13.0.0",
    "expo-clipboard": "6.0.3",
    "expo-constants": "~16.0.0",
    "expo-document-picker": "^13.1.5",
    "expo-font": "~12.0.0",
    "expo-haptics": "~13.0.0",
    "expo-image-manipulator": "~12.0.5",
    "expo-image-picker": "15.0.7",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~6.3.0",
    "expo-location": "~17.0.0",
    "expo-notifications": "0.28.19",
    "expo-router": "~3.5.0",
    "expo-secure-store": "~13.0.0",
    "expo-splash-screen": "~0.27.0",
    "expo-status-bar": "~1.12.0",
    "expo-system-ui": "~3.0.0",
    "expo-updates": "~0.25.28",
    "react": "18.2.0",
    "react-native": "0.74.0",
    "react-native-gesture-handler": "~2.16.0",
    "react-native-get-random-values": "^1.9.0",
    "react-native-reanimated": "~3.10.0",
    "react-native-safe-area-context": "4.10.1",
    "react-native-screens": "3.31.1",
    "react-native-webrtc": "^118.0.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.2.0",
    "jest-expo": "~51.0.0",
    "jimp": "^1.6.1",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.3.0"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@noble/.*)",
      "/node_modules/react-native-reanimated/plugin/"
    ],
    "moduleNameMapper": {
      "^@react-native-async-storage/async-storage$": "@react-native-async-storage/async-storage/jest/async-storage-mock"
    }
  }
}
