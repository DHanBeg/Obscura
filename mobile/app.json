{
  "expo": {
    "name": "Obscura",
    "slug": "obscura",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/logo.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#080808"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "network.obscura.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Görüntülü arama için kamera erişimi gerekiyor",
        "NSMicrophoneUsageDescription": "Sesli ve görüntülü arama için mikrofon erişimi gerekiyor",
        "NSContactsUsageDescription": "Rehberinizdeki kişileri Obscura'da bulmak için"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08080E"
      },
      "notification": {
        "icon": "./assets/notification-icon.png",
        "color": "#00E5A0"
      },
      "package": "network.obscura.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_CONTACTS",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080808",
          "image": "./assets/logo.jpeg"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Konum paylaşmak için konum erişimi gerekiyor.",
          "locationAlwaysPermission": "Arka planda konum paylaşımı için gerekiyor."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fotoğraf seçmek için galeri erişimi gerekiyor.",
          "cameraPermission": "Fotoğraf çekmek için kamera erişimi gerekiyor."
        }
      ]
    ],
    "scheme": "obscura",
    "extra": {
      "eas": {
        "projectId": "26840fb0-f5c4-4f46-85eb-1b587b5fb4d1"
      },
      "apiUrl": "https://obscura-backend-production-1827.up.railway.app",
      "wsUrl": "wss://obscura-backend-production-1827.up.railway.app",
      "router": {
        "origin": false
      }
    },
    "owner": "karaefendi",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/26840fb0-f5c4-4f46-85eb-1b587b5fb4d1"
    }
  }
}
