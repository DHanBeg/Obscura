# ─── Obscura Ağı — Ortam Değişkenleri ────────────────────────────────────────
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun:
#   cp .env.example .env

# ─── Backend ──────────────────────────────────────────────────────────────────
PORT=8080
DATA_DIR=./data
NODE_ID=node-1
NODE_PEERS=node-2:8082,node-3:8083,node-4:8084,node-5:8085
NODE_INTERNAL_SECRET=CHANGE_THIS_SECRET_IN_PRODUCTION

# INTERNAL_SECRET: NODE_INTERNAL_SECRET'ten KASITLI olarak ayrı — ayrı
# trust-domain (bkz. backend/internal/storage/sharding.go:31-40, zk/multi_verify.go:29-33,
# api/storage_handlers.go:22-25 yorumları). NODE_INTERNAL_SECRET yalnız
# internal/gossip P2P relay protokolünü korur; INTERNAL_SECRET ise api
# paketindeki TÜM X-Internal-Secret tüketicilerinin (event check-in HMAC,
# zk-circuit admin endpoint) ve node-to-node shard transferinin (storage
# sign + api verify) ortak anahtarıdır — iki farklı, birbirini etkilememesi
# gereken güven sınırı.
INTERNAL_SECRET=CHANGE_THIS_INTERNAL_SECRET_IN_PRODUCTION

# JWT — Production'da güçlü random bir değer kullanın
# openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_JWT_SECRET_IN_PRODUCTION

# ─── Gizlilik Pepper'ları ─────────────────────────────────────────────────────
# İkisi de HMAC anahtarı olarak tek yönlü kullanılır (hash girdisi — iki
# taraflı eşleşme/karşılaştırma DEĞİL). Birbirinden ve INTERNAL_SECRET'ten
# KASITLI ayrı: biri sızarsa diğerleri etkilenmesin, rotasyon bağımsız kalsın.
# OBSCURA_PHONE_PEPPER: telefon hash'i (subscriber/crypto.go:97, PepperFromEnv).
OBSCURA_PHONE_PEPPER=CHANGE_THIS_PHONE_PEPPER_IN_PRODUCTION
# OBSCURA_MESSAGE_OWNER_PEPPER: sealed mesaj owner_hash'i, bkz. ADR-0016
# (api/owner_hash.go:48, computeOwnerHash — HMAC-SHA256(pepper, DID+msgID)).
OBSCURA_MESSAGE_OWNER_PEPPER=CHANGE_THIS_MESSAGE_OWNER_PEPPER_IN_PRODUCTION
# OBSCURA_LOG_REDACT_KEY: stdout log satırlarındaki DID/telefon redaksiyonu
# (logredact/logredact.go, HMAC-SHA256(key, ham değer)[:8] → 16 hex).
OBSCURA_LOG_REDACT_KEY=CHANGE_THIS_LOG_REDACT_KEY_IN_PRODUCTION

# ─── SMS (OTP) ────────────────────────────────────────────────────────────────
# Seçenekler: log (dev) | twilio | netgsm | vodafone | custom
SMS_PROVIDER=log

# Twilio (SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Netgsm (SMS_PROVIDER=netgsm)
SMS_NETGSM_USER=
SMS_NETGSM_PASS=
SMS_NETGSM_HEADER=OBSCURA

# Vodafone Business (SMS_PROVIDER=vodafone)
SMS_VODAFONE_KEY=
SMS_VODAFONE_FROM=Obscura

# Custom HTTP (SMS_PROVIDER=custom)
SMS_API_URL=
SMS_API_KEY=

# ─── Push Bildirimleri ────────────────────────────────────────────────────────
# Firebase Cloud Messaging (FCM)
FCM_PROJECT_ID=
FCM_LEGACY_KEY=
# FCM_SERVICE_KEY_FILE=/path/to/service-account.json

# ─── MinIO (Self-hosted S3) ───────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=obscura-admin
MINIO_SECRET_KEY=CHANGE_THIS_MINIO_SECRET
MINIO_BUCKET=obscura-media
MINIO_USE_SSL=false

# ─── Postgres (5 node için ayrı database — HAZIRLIK, sqlite hâlâ varsayılan) ──
# docker-compose.yml'deki POSTGRES_PASSWORD ve OBSCURA_DB_DSN (node-1..5)
# buradan interpolasyonla besleniyor (${POSTGRES_PASSWORD}) — tek kaynak,
# 6 yerde aynı değer. Backend henüz OBSCURA_DB_DRIVER=postgres'i desteklemiyor
# (bkz. backend/internal/db/database.go), ama postgres container'ının kendi
# auth'u zaten bu değeri kullanıyor.
# openssl rand -hex 32 — DSN userinfo'ya gömülü olduğu için base64 DEĞİL
# (base64'ün ürettiği /, +, = DSN'i kırar).
POSTGRES_PASSWORD=CHANGE_THIS_POSTGRES_PASSWORD_IN_PRODUCTION

# ─── TURN/coturn ─────────────────────────────────────────────────────────────
# webrtc.go ve coturn/turnserver.conf'daki secret eşleşmeli.
# TURN_SECRET (tercih edilen) veya TURN_SHARED_SECRET (legacy) kullanılabilir.
# OBSCURA_ENV=production iken eksikse process panic eder.
TURN_SECRET=
TURN_SHARED_SECRET=CHANGE_THIS_TURN_SECRET

# ─── Grafana ──────────────────────────────────────────────────────────────────
# docker-compose.yml'deki GF_SECURITY_ADMIN_PASSWORD buradan interpolasyonla
# besleniyor (${GF_SECURITY_ADMIN_PASSWORD}).
GF_SECURITY_ADMIN_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD_IN_PRODUCTION

# ─── Çalışma Modu ─────────────────────────────────────────────────────────────
# production iken zorunlu secret eksiklerinde panic; dev'de placeholder kullanılır.
# local dev için: development'a çevir (dev_otp + gevşek secret). prod/deploy: production bırak.
OBSCURA_ENV=production

# ─── P2P (libp2p — FAZ 3) ────────────────────────────────────────────────────
# P2P_ENABLED=false ile HTTP gossip moduna dön (dev için)
P2P_ENABLED=true
# QUIC tek gerçek transport (TCP register edilmemiş, kasıtlı olarak kaldırıldı)
P2P_LISTEN_QUIC=/ip4/0.0.0.0/udp/9001/quic-v1
# BOOTSTRAP_PEERS: virgülle ayrılmış, PEER ID İÇEREN multiaddr listesi (ZORUNLU
# — otomatik NODE_PEERS türetme yok, peer ID'siz adres asla bağlanamaz).
# Örn: /dns4/bootstrap.obscura.network/udp/9001/quic-v1/p2p/QmXxx
# Boş bırakılırsa node bootstrapsız başlar (izole kalabilir).
BOOTSTRAP_PEERS=
# P2P_ZK_AUTH=true — bağlanan peer'lardan node_proof ZK kanıtı ister
# Başlangıçta false; tüm node'lar ZK proof üretebilir hale gelince true yap
P2P_ZK_AUTH=false
# P2P_KEY_PATH: Ed25519 identity key dosya yolu (aynı PeerID garantisi)
# Boş bırakılırsa her başlatmada yeni PeerID üretilür (dev modu)
P2P_KEY_PATH=/data/p2p_identity.key

# ─── ZK Verification Keys ─────────────────────────────────────────────────────
# Default (false): backend/internal/zk/keys/*.json embed edilmiş binary'den
# yüklenir — production-safe. true iken disk'ten yüklemeye fallback eder
# (sadece dev ortamlarda kullanılmalı).
OBSCURA_ZK_KEYS_FROM_DISK=false

# ─── Bridge (Cross-chain — FAZ 4) ─────────────────────────────────────────────
# DOT_RPC_URL: Polkadot/Paseo JSON-RPC uç noktası (HTTPS — bridge.go ham
# net/http POST kullanıyor, watch.go extrinsic izleme için wss:// türetiyor).
# Public Paseo örneği (Dwellir, key gerektirmez, test edildi):
DOT_RPC_URL=https://paseo-rpc.n.dwellir.com

# DOT_RELAYER_SEED: relayer'ın ETH Locked event'lerine karşılık DOT
# extrinsic'i imzalayacağı hesabın seed'i. İKİ biçim desteklenir:
#   - "//Alice" gibi bir Substrate dev-hesap kısayolu — SADECE test/kanıt
#     amaçlı, gerçek fon taşımaz güvenliği yok.
#   - 32-baytlık ham hex seed (64 hex karakter, "0x" opsiyonel) — gerçek
#     relayer hesabı için. GERÇEK SEED'İ ASLA .env'e/repo'ya COMMIT ETMEYİN —
#     production'da secret manager kullanın.
# Boş bırakılırsa DOT tarafı devre dışı kalır, event'ler DB'de 'pending'
# bekler (relayer.go, processDotSide).
DOT_RELAYER_SEED=

# DOT_RELAYER_AUTO_SUBMIT: "true" olmadıkça relayer DOT extrinsic'ini SADECE
# hazırlar/imzalar/decode ile doğrular, author_submitExtrinsic'i HİÇ
# ÇAĞIRMAZ (status='ready_to_submit' olarak bekler). Bridge madde 4 PARÇA 3
# kapsamında varsayılan/güvenli değer budur — gerçek otomatik gönderim PARÇA
# 4'te açık onayla etkinleştirilir.
DOT_RELAYER_AUTO_SUBMIT=false

# ETH_RPC_URL: Sepolia JSON-RPC uç noktası (contracts/bridge/hardhat.config.js
# okur). Boş bırakılırsa public https://ethereum-sepolia-rpc.publicnode.com
# kullanılır.
ETH_RPC_URL=

# ETH_DEPLOYER_PRIVKEY: Sepolia'ya OBSToken/OBSBridge deploy edecek cüzdanın
# private key'i (hardhat imzalaması için). SADECE Sepolia testnet cüzdanı —
# gerçek fon barındırmasın. ASLA commit etmeyin.
ETH_DEPLOYER_PRIVKEY=

# OBS_TOKEN_ADDRESS: contracts/bridge/scripts/deploy-token.js çalıştıktan
# sonra buraya (veya .env.bridge'e) yazılan test token adresi — OBSBridge
# deploy'u (deploy.js) bunu okur.
OBS_TOKEN_ADDRESS=

# ETH_BRIDGE_CONTRACT: contracts/bridge/deploy.js çalıştıktan sonra buraya
# yazılan OBSBridge kontrat adresi — relayer.go bu adresi dinler.
ETH_BRIDGE_CONTRACT=

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Web Push (VAPID key — npx web-push generate-vapid-keys ile üretin)
NEXT_PUBLIC_VAPID_KEY=
