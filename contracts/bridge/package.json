{
  "name": "@obscura/bridge-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Ethereum-side OBSBridge contract + Hardhat deploy tooling",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:token:sepolia": "hardhat run scripts/deploy-token.js --network sepolia",
    "deploy:sepolia": "hardhat run deploy.js --network sepolia",
    "deploy:local": "hardhat run deploy.js --network localhost"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "hardhat": "^2.22.0"
  }
}
